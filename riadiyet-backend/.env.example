DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/riadiyet_db"

# ─── JWT SECRETS ──────────────────────────────────────────────────────────────
# Must each be at least 32 random characters.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use DIFFERENT values for access vs refresh.
JWT_ACCESS_SECRET="replace_with_64_char_random_hex_string_access"
JWT_REFRESH_SECRET="replace_with_64_char_random_hex_string_refresh"

# Token lifetimes (s=seconds m=minutes h=hours d=days)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of your Next.js frontend
FRONTEND_URL="http://localhost:3000"

# ─── BCRYPT ───────────────────────────────────────────────────────────────────
# 12 is a good balance of security vs speed for development
BCRYPT_ROUNDS=12
